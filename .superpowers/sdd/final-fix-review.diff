+            ranked_path = temp_dir / "ranked.json"
+            authorization_path = temp_dir / "authorization.json"
+            packet_input_path = temp_dir / "packet-input.json"
+            packet_path = temp_dir / "packet.md"
+
+            score = run_cli(
+                SCRIPTS_DIR / "score_candidates.py",
