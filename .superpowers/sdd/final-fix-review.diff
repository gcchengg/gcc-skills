+TEMPLATES_DIR = SKILL_DIR / "templates"
+
+
+def run_cli(*arguments, cwd):
+    return subprocess.run(
+        [sys.executable, *map(str, arguments)],
+        cwd=cwd,
+        text=True,
+        capture_output=True,
+        check=False,
+    )
+
+
+class CliWorkflowTest(unittest.TestCase):
