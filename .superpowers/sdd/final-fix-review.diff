+    def test_cli_failures_are_nonzero_and_explain_the_rejection(self):
+        with tempfile.TemporaryDirectory() as temp_value:
+            temp_dir = Path(temp_value)
+            pool_path = TEMPLATES_DIR / "ip-pool.example.json"
+            candidates = json.loads(
